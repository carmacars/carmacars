# Copy to .env.local for local development. Never commit real values. See docs/setup.md.
# Staging and production values live in GitHub repository secrets and variables, per environment.
# No secret is ever pasted into a chat, an email or a ticket.

# --- app
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ENV=local                         # local | staging | production

# --- Supabase (database, sign-in, pg_cron, Edge Functions)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=        # browser key; row-level security applies
SUPABASE_SERVICE_ROLE_KEY=            # server only; bypasses row-level security
DATABASE_URL=                         # direct Postgres connection: migrations and the nightly backup only

# --- Stripe (cards, holds, pre-authorized debit; pay per transaction, no Billing or Invoicing)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=                # signing secret of the stripe-webhook Edge Function endpoint
STRIPE_HST_TAX_RATE_ID=               # the "HST 13%, Ontario, exclusive" tax rate

# --- identity checks
IDENTITY_PROVIDER=staff_review        # staff_review (default) | stripe (Stripe Identity, CA$2.00 per check)

# --- Cloudflare R2 (files: private buckets, short-lived signed links)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PREFIX=carmacars-local-     # carmacars-staging- | carmacars-prod- ; bucket names are in docs/architecture.md section 6
NEXT_PUBLIC_VEHICLE_PHOTOS_URL=       # public address of the vehicle-public bucket

# --- Resend (platform email, sent from mail.carmacars.ca; email only at launch)
RESEND_API_KEY=
EMAIL_FROM=                           # an address at mail.carmacars.ca
EMAIL_REPLY_TO=                       # a staff alias at carmacars.ca (Google Workspace), such as bookings@

# --- Cloudflare Turnstile (protects public forms)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- GPS tracker
TRACKER_API_URL=
TRACKER_API_KEY=
TRACKER_WEBHOOK_SECRET=               # checked by the tracker-webhook Edge Function

# --- vehicle photo pipeline
PHOTO_PIPELINE_URL=
PHOTO_PIPELINE_KEY=

# --- encryption of bank account numbers at rest (application layer)
FIELD_ENCRYPTION_KEY=

# --- GitHub Actions only (never in .env.local): CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_ID,
#     SUPABASE_ACCESS_TOKEN, SUPABASE_PROJECT_REF, BACKUP_ENCRYPTION_KEY. See docs/setup.md section 6.
