# Copy to .env.local. Never commit real values. See docs/setup.md.

# --- app
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ENV=local                         # local | preview | production
CRON_SECRET=                          # shared secret Vercel Cron sends to /api/cron/*

# --- Supabase (database, auth, storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=        # browser key; row-level security applies
SUPABASE_SERVICE_ROLE_KEY=            # server only; bypasses row-level security
DATABASE_URL=                         # direct Postgres connection, for migrations only

# --- Stripe (cards, holds, pre-authorized debit, identity checks)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_HST_TAX_RATE_ID=               # the "HST 13%, Ontario, exclusive" tax rate

# --- e-signature service
ESIGN_PROVIDER=                       # adapter name
ESIGN_API_KEY=
ESIGN_WEBHOOK_SECRET=

# --- GPS tracker
TRACKER_API_URL=
TRACKER_API_KEY=
TRACKER_WEBHOOK_SECRET=

# --- messaging
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=
SMS_PROVIDER_API_KEY=
SMS_FROM=

# --- vehicle photo pipeline
PHOTO_PIPELINE_URL=
PHOTO_PIPELINE_KEY=

# --- encryption of bank account numbers at rest (application layer)
FIELD_ENCRYPTION_KEY=
