# Non-secret settings of the self-hosted stack (committed). Secrets are in /opt/carmacars/supabase/.env on the server
# only (mode 600, written by infra/vps/scripts/make-env.sh); a value there wins over the same name here.
# /opt/carmacars/bin/dc runs: docker compose --env-file defaults.env --env-file .env ...

# ---------------------------------------------------------------- addresses
API_HOSTNAME=api.carmacars.ca
API_EXTERNAL_URL=https://api.carmacars.ca
SUPABASE_PUBLIC_URL=https://api.carmacars.ca
SITE_URL=https://carmacars.ca
ACME_EMAIL=rent@carmacars.ca

# ---------------------------------------------------------------- Postgres
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432
# The hosted project runs Postgres 17. The official self-hosted compose's image (the platform's own newer tags do not
# initialise the self-hosted roles and schemas); make-env.sh writes the choice to .env as PG_IMAGE once.
PG_IMAGE=supabase/postgres:17.6.1.136

# Tuned for the OVHcloud VPS-4: 8 vCPU, 24 GB RAM, NVMe. The other containers use about 2 to 3 GB together.
PG_SHARED_BUFFERS=6GB
PG_EFFECTIVE_CACHE_SIZE=16GB
PG_WORK_MEM=32MB
PG_MAINTENANCE_WORK_MEM=1GB
PG_MAX_CONNECTIONS=200
PG_WAL_BUFFERS=64MB
PG_MIN_WAL_SIZE=1GB
PG_MAX_WAL_SIZE=4GB
# WAL volume (docs/backups.md): lz4 full-page compression, a checkpoint every 15 minutes (max_wal_size above leaves room)
PG_WAL_COMPRESSION=lz4
PG_CHECKPOINT_TIMEOUT=15min
PG_MAX_WORKER_PROCESSES=16
PG_MAX_PARALLEL_WORKERS=8
PG_MAX_PARALLEL_WORKERS_PER_GATHER=4
PG_MAX_PARALLEL_MAINTENANCE_WORKERS=4
# parallel queries use /dev/shm (Docker's default is 64 MB)
PG_SHM_SIZE=2gb
# statements slower than this are logged (docker logs supabase-db)
PG_LOG_MIN_DURATION_STATEMENT=2000

# ---------------------------------------------------------------- APIs
JWT_EXPIRY=3600
# make-env.sh replaces these with the hosted project's values (GET /v1/projects/{ref}/postgrest)
PGRST_DB_SCHEMAS=public,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public,extensions
PGRST_DB_POOL=20
FUNCTIONS_VERIFY_JWT=false

# ---------------------------------------------------------------- Storage (files on the server's disk)
STORAGE_TENANT_ID=stub
GLOBAL_S3_BUCKET=stub
REGION=local
