#!/usr/bin/env bash
# Prints one value of /opt/carmacars/supabase/.env, or of functions.env when .env does not have it (root only; used
# by CI through sudo, never logged).
set -euo pipefail
name="${1:-}"
[[ "$name" =~ ^[A-Z][A-Z0-9_]*$ ]] || { echo "usage: secret NAME" >&2; exit 2; }
for f in /opt/carmacars/supabase/.env /opt/carmacars/supabase/functions.env; do
  [ -f "$f" ] || continue
  line=$(grep -m1 "^$name=" "$f" || true)
  [ -n "$line" ] || continue
  v="${line#*=}"; v="${v#\'}"; v="${v%\'}"
  printf '%s' "$v"
  exit 0
done
exit 0
