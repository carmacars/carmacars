#!/usr/bin/env bash
# Start the database over from an empty data directory (the copy workflow's first step, so every copy is a full,
# clean one). Refused once the server is live (/opt/carmacars/state/live, set by the cutover): then the data here is
# the only copy of new bookings. The db-config volume (vault root key, supautils settings) is made anew; files are kept.
set -euo pipefail
D=/opt/carmacars
if [ -f "$D/state/live" ]; then echo "db-reset: refused, this server is the live backend since $(cat "$D/state/live")" >&2; exit 1; fi
[ "${1:-}" = --yes ] || { echo "usage: db-reset --yes" >&2; exit 2; }
"$D/bin/dc" stop
rm -rf "$D/supabase/volumes/db/data"
# the image's config volume (supautils settings, the vault's root key) belongs to the cluster: made fresh by the image
# that initialises the new one (the copy re-creates the vault secrets from their decrypted values)
"$D/bin/dc" rm -f db > /dev/null 2>&1 || true
docker volume rm supabase_db-config > /dev/null 2>&1 || true
mkdir -p "$D/supabase/volumes/db/data"
rm -f "$D/wal-spool/"* 2>/dev/null || true
"$D/bin/stack-up"
# a new cluster: the bucket's base backups and WAL belong to the old one (same file names, different system id)
if [ -f "$D/backup/enabled-flag/enabled" ]; then
  "$D/bin/walg" delete everything FORCE --confirm > /dev/null 2>&1 || true
  echo "db-reset: the old cluster's wal-g backups were removed; the copy takes a new base backup at its end"
fi
