#!/usr/bin/env bash
# Point the server's backups at the S3-compatible bucket (the vps-backup workflow, mode configure). Reads a JSON
# object on stdin: endpoint, region, bucket, access_key_id, secret_access_key, walg_key (64 hex characters: wal-g's
# libsodium key; keep a copy outside the server, the backups cannot be read without it), retain_full (optional;
# else the value already set, else 7).
# Writes /opt/carmacars/backup/walg.env (600), sets the flag that switches WAL archiving on, checks the bucket with
# wal-g, and takes the first base backup when there is none. Safe to run again (new keys replace the old ones).
set -euo pipefail
D=/opt/carmacars
in=$(cat)
v() { jq -r --arg k "$1" '.[$k] // empty' <<<"$in"; }
bad=()
endpoint=$(v endpoint); [ -n "$endpoint" ] && [[ "$endpoint" != http*://* ]] && endpoint="https://$endpoint"
endpoint="${endpoint%/}"
[[ "$endpoint" =~ ^https://[A-Za-z0-9.-]+(:[0-9]+)?(/.*)?$ ]] || bad+=("endpoint (https://host)")
[[ "$(v bucket)" =~ ^[a-z0-9][a-z0-9.-]+$ ]] || bad+=(bucket)
[ -n "$(v access_key_id)" ] || bad+=(access_key_id)
[ -n "$(v secret_access_key)" ] || bad+=(secret_access_key)
# wal-g's libsodium key: 64 hex characters, base64 of 32 bytes, or 32 plain characters
key=$(v walg_key); transform=""
if [[ "$key" =~ ^[0-9a-fA-F]{64}$ ]]; then transform=hex
elif [ "$(printf '%s' "$key" | base64 -d 2>/dev/null | wc -c)" = 32 ]; then transform=base64
elif [ "${#key}" = 32 ]; then transform=none
else bad+=("walg_key (64 hex, base64 of 32 bytes, or 32 characters; got ${#key} characters)"); fi
if [ "${#bad[@]}" -gt 0 ]; then echo "backup-configure: not usable: ${bad[*]}" >&2; exit 2; fi
for k in region bucket access_key_id secret_access_key walg_key; do
  case "$(v "$k")" in *"'"*|*$'\n'*) echo "backup-configure: $k holds a quote or newline" >&2; exit 2 ;; esac
done
# the retention: the input's retain_full, else the one already in walg.env (the vps-ops workflow's apply-retention may
# have lowered it to keep the bucket small), else 7
retain=$(jq -r '.retain_full // empty' <<<"$in")
[ -n "$retain" ] || retain=$(sed -n "s/^WALG_RETAIN_FULL='\{0,1\}\([0-9]*\)'\{0,1\}$/\1/p" "$D/backup/walg.env" 2>/dev/null | tail -n 1 || true)
[[ "${retain:-}" =~ ^[0-9]+$ ]] && [ "$retain" -ge 2 ] || retain=7
install -d -m 700 "$D/backup"
t=$(mktemp -p "$D/backup"); chmod 600 "$t"
cat > "$t" <<CONF
# wal-g settings (infra/vps/bin/backup-configure). Secret.
WALG_S3_PREFIX='s3://$(v bucket)/walg'
AWS_ENDPOINT='$endpoint'
AWS_REGION='$(v region)'
AWS_S3_FORCE_PATH_STYLE='true'
AWS_ACCESS_KEY_ID='$(v access_key_id)'
AWS_SECRET_ACCESS_KEY='$(v secret_access_key)'
WALG_LIBSODIUM_KEY='$(v walg_key)'
WALG_LIBSODIUM_KEY_TRANSFORM='$transform'
WALG_COMPRESSION_METHOD='zstd'
WALG_UPLOAD_CONCURRENCY='4'
WALG_DOWNLOAD_CONCURRENCY='4'
WALG_RETAIN_FULL='$retain'
PGDATA='/var/lib/postgresql/data'
PGHOST='127.0.0.1'
PGPORT='5432'
PGUSER='supabase_admin'
PGDATABASE='postgres'
CONF
mv "$t" "$D/backup/walg.env"
# the bucket answers (an empty listing is fine)
"$D/bin/walg" backup-list > /dev/null 2> "$D/state/walg-check.err" || grep -qi 'no backups found' "$D/state/walg-check.err" \
  || { echo "backup-configure: the bucket did not answer: $(tail -n 3 "$D/state/walg-check.err" | tr '\n' ' ')" >&2; exit 1; }
install -d -m 755 "$D/backup/enabled-flag"
date -u +%FT%TZ > "$D/backup/enabled-flag/enabled"; chmod 644 "$D/backup/enabled-flag/enabled"
# switch to a new WAL file so archiving starts at once
docker exec supabase-db psql -U supabase_admin -d postgres -XAtc "select pg_switch_wal()" > /dev/null
if ! "$D/bin/walg" backup-list 2>/dev/null | grep -q base_; then
  "$D/bin/walg-base"
fi
"$D/bin/walg" backup-list 2>/dev/null | tail -n 3
