#!/usr/bin/env bash
# Edge Function secrets: a JSON array [{"name": ..., "value": ...}] on stdin, added to or replacing the entries of
# functions.env (the others are kept); the functions container is recreated when anything changed.
set -euo pipefail
S=/opt/carmacars/supabase
F=$S/functions.env
in=$(cat)
jq -e --arg q "'" 'type == "array" and all(.[]; (.name | test("^[A-Z_][A-Z0-9_]*$")) and (.value | type == "string") and ((.value | contains($q)) or (.value | test("[\\n\\r]")) | not))' <<<"$in" > /dev/null \
  || { echo "fn-secrets: expected [{name, value}] with NAMES in capitals and values without quotes or newlines" >&2; exit 2; }
touch "$F"; chmod 600 "$F"
tmp=$(mktemp); chmod 600 "$tmp"
cp "$F" "$tmp"
while IFS=$'\t' read -r name value; do
  grep -v "^$name=" "$tmp" > "$tmp.n" || true
  printf "%s='%s'\n" "$name" "$value" >> "$tmp.n"
  mv "$tmp.n" "$tmp"
done < <(jq -r '.[] | [.name, .value] | @tsv' <<<"$in")
sort -o "$tmp" "$tmp"
if sort "$F" | cmp -s "$tmp" -; then rm -f "$tmp"; echo '{"changed":false}'; exit 0; fi
install -m 600 "$tmp" "$F"; rm -f "$tmp"
/opt/carmacars/bin/dc up -d --wait functions > /dev/null
echo '{"changed":true}'
