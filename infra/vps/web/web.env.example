# The names /opt/carmacars/web/web.env holds on the server (written by the deploy-vps job from the same sources as the
# Worker's secrets; never committed with values). One NAME=value a line.
APP_ENV=production
DATA_BACKEND=supabase
NEXT_PUBLIC_APP_URL=https://www.example.com
NEXT_PUBLIC_SUPABASE_URL=https://api.example.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
LINK_SIGNING_KEY=
# files: Supabase Storage on this server (r2 with the R2_* S3 keys also works; r2-binding needs a Worker)
STORAGE_PROVIDER=supabase
# AI: workers-ai over REST with the two values below (free daily allowance); without them the fake
LLM_PROVIDER=workers-ai
CLOUDFLARE_ACCOUNT_ID=
WORKERS_AI_API_TOKEN=
GEMINI_API_KEY=
# photos: the steps are made in the app; the cut-out and HEIC, which asked Cloudflare, fall back to the local step
PHOTO_PROVIDER=cloudflare
TURNSTILE_PROVIDER=cloudflare
TURNSTILE_SECRET_KEY=
PAYMENTS_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
