# r50 (5010): LiveKit's settings, written by up.sh (the @...@ values). Never committed with keys.
port: 7880
log_level: info
rtc:
  tcp_port: 7881
  port_range_start: 50000
  port_range_end: 50199
  use_external_ip: true
keys:
  @KEY@: @SECRET@
room:
  empty_timeout: 300
  departure_timeout: 20
  max_participants: 80
webhook:
  api_key: @KEY@
  urls:
    - @WEBHOOK@
turn:
  enabled: true
  domain: @HOST@
  udp_port: 3478
# tls-begin
  tls_port: 5349
  cert_file: /tls/cert.pem
  key_file: /tls/key.pem
# tls-end
