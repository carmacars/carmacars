{
  "name": "carmacars-native",
  "version": "1.0.0",
  "private": true,
  "description": "The CarmaCars app for iPhone and Android: native screens (Expo, React Native) on the site's mobile API (/api/m/v1). docs/apps/native-publish.md.",
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "expo start",
    "typecheck": "tsc --noEmit -p .",
    "test": "node --test --experimental-strip-types --no-warnings 'src/**/*.test.ts'",
    "check": "node scripts/check-app.mjs",
    "prebuild": "expo prebuild --clean --no-install",
    "doctor": "expo-doctor"
  },
  "dependencies": {
    "@react-native-community/datetimepicker": "^9.2.1",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-firebase/app": "^27.1.1",
    "@react-native-firebase/messaging": "^27.1.1",
    "@stripe/stripe-react-native": "0.81.0",
    "expo": "~58.0.26",
    "expo-application": "~58.1.2",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-device": "~58.0.5",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.17",
    "expo-local-authentication": "~58.0.3",
    "expo-location": "~58.0.22",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.1.0",
    "react": "19.3.0",
    "react-dom": "^19.3.0",
    "react-native": "0.88.1",
    "react-native-passkey": "^3.6.2",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-view-shot": "6.1.1",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "typescript": "~5.9.3"
  }
}
