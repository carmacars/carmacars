{
  "name": "carmacars-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "node scripts/serve.mjs",
    "lint": "eslint --max-warnings=0 .",
    "typecheck": "tsc --noEmit",
    "db:up": "bash scripts/local-db.sh up",
    "db:reset": "bash scripts/local-db.sh reset",
    "db:down": "bash scripts/local-db.sh down",
    "db:types": "node scripts/gen-types.mjs",
    "seed": "node scripts/seed.mjs",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "test:e2e": "playwright test",
    "check:links": "node tests/lint/linkcheck.mjs",
    "check:copy": "node tests/lint/copylint.mjs",
    "check:lighthouse": "node tests/lint/lighthouse.mjs",
    "test:unit": "node --test --experimental-strip-types --no-warnings 'src/**/*.test.ts'",
    "gen:agreement": "node scripts/gen-agreement.mjs",
    "gen:owner-agreements": "node scripts/gen-owner-agreements.mjs",
    "check:crawl": "node tests/lint/crawl-roles.mjs",
    "check:seo": "node tests/lint/seo-audit.mjs",
    "check:emails": "node tests/lint/emails-db.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "aws4fetch": "^1.0.20",
    "jose": "^6.2.12",
    "next": "16.3.8",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.9",
    "qrcode-generator": "2.0.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@opennextjs/cloudflare": "^1.20.10",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "lighthouse": "^13.5.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.149.0"
  }
}
