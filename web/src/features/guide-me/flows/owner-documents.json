{
  "id": "owner-documents",
  "title": "Your documents",
  "summary": "Your agreements, schedules and forms, signed copies to download.",
  "who": [
    "owner"
  ],
  "start": "/owner/documents",
  "guide": {
    "portal": "owner",
    "slug": "start-here"
  },
  "steps": [
    {
      "id": "tabs",
      "target": "portal-tabs",
      "text": "Documents: to sign, and your signed files.",
