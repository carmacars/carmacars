      "href": "/owner/documents"
    },
    {
      "id": "forms",
      "target": "government-forms",
      "text": "Government forms for each car: sign what is waiting and download the copies.",
      "on": "/owner/documents",
      "page": "page-head",
      "when": {
        "exists": "government-forms"
      }
    },
    {
      "id": "sign",
      "target": "government-form-sign",
      "text": "Sign a form waiting for you.",
      "on": "/owner/documents",
      "page": "page-head",
      "when": {
        "exists": "government-form-sign"
      }
    }
  ]
}
