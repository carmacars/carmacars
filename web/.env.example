# Web app environment. Copy to .env.local for local development (scripts/local-db.sh prints DATABASE_URL).
# Every variable is typed and checked in src/lib/env.ts; a missing required value stops the server
# with the variable's name. Repository-wide variables are in ../.env.example.

# --- app
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ENV=local                          # local | staging | production
DATA_BACKEND=local                     # local (Postgres driver, row-level security per transaction) | supabase

# --- local stack only (DATA_BACKEND=local)
DATABASE_URL=postgresql://postgres@127.0.0.1:54322/carmacars
LOCAL_AUTH_SECRET=local-dev-secret-change-me-32-characters-min

# --- Supabase (DATA_BACKEND=supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=             # server only; never in a NEXT_PUBLIC_ variable

# --- vehicle photos (public bucket); local: served from public/_local by the dev server
NEXT_PUBLIC_VEHICLE_PHOTOS_URL=/_local/vehicle-public

# --- Cloudflare Turnstile. Local uses Cloudflare's always-pass test keys with the fake widget.
TURNSTILE_PROVIDER=fake                # cloudflare | fake
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- links that act without a session (driver signing links, upload tickets); 32+ random characters
LINK_SIGNING_KEY=local-link-signing-key-change-me-32-chars

# --- integrations: each has a real adapter and a fake (src/integrations/<name>/)
PAYMENTS_PROVIDER=fake                 # stripe | fake
STRIPE_SECRET_KEY=                     # server only (Worker secret); test mode key on staging
STRIPE_WEBHOOK_SECRET=                 # whsec_... of the endpoint /api/webhooks/stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STORAGE_PROVIDER=local                 # r2 | local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PREFIX=carmacars-local-
MAPS_PROVIDER=fake                     # google | fake
GOOGLE_MAPS_API_KEY=                   # server key: Places Autocomplete (New) and Routes; restricted by IP or referrer
