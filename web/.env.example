# Web app environment. Copy to .env.local for local development (scripts/local-db.sh prints DATABASE_URL).
# Every variable is typed and checked in src/lib/env.ts; a missing required value stops the server
# with the variable's name. Repository-wide variables are in ../.env.example.

# --- app
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ENV=local                          # local | staging | production
DATA_BACKEND=local                     # local (Postgres driver, row-level security per transaction) | supabase

# --- local stack only (DATA_BACKEND=local)
DATABASE_URL=postgresql://postgres@127.0.0.1:54322/carmacars
LOCAL_AUTH_SECRET=local-dev-secret-change-me-32-characters-min

# --- Supabase (DATA_BACKEND=supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=             # server only; never in a NEXT_PUBLIC_ variable
SUPABASE_JWT_SECRET=                   # server only; the project's JWT secret, for Admin "view as" of renter and owner portals (the deploy sets it)

# --- vehicle photos (public bucket); local: served from public/_local by the dev server
NEXT_PUBLIC_VEHICLE_PHOTOS_URL=/_local/vehicle-public

# --- Cloudflare Turnstile. Local uses Cloudflare's always-pass test keys with the fake widget.
TURNSTILE_PROVIDER=fake                # cloudflare | fake | off (production until the widget exists)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- links that act without a session (driver signing links, upload tickets); 32+ random characters
LINK_SIGNING_KEY=local-link-signing-key-change-me-32-chars

# --- integrations: each has a real adapter and a fake (src/integrations/<name>/)
PAYMENTS_PROVIDER=fake                 # stripe | fake
STRIPE_SECRET_KEY=                     # server only (Worker secret); test mode key on staging
STRIPE_WEBHOOK_SECRET=                 # whsec_... of the endpoint /api/webhooks/stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STORAGE_PROVIDER=local                 # r2 (S3 keys) | r2-binding (Worker bindings, production) | local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PREFIX=carmacars-local-
MAPS_PROVIDER=fake                     # google | fake
GOOGLE_MAPS_API_KEY=                   # server key: Places Autocomplete (New) and Routes; restricted by IP or referrer

# --- owner payout account numbers are encrypted (AES-GCM) before they reach the database; 32+ random characters.
# Local falls back to a fixed development key. Production must set it (and never change it without re-encrypting).
PAYOUT_ENCRYPTION_KEY=
# --- VIN decoding for the owner wizard: vpic (NHTSA vPIC, free, no key) | fake (sample answers)
VIN_DECODER=fake
# --- listing pipeline (migration 0032): copy drafts and photo editing. Production: workers-ai (the Worker's AI binding)
# and cloudflare (image transformations on the zone); locally the fakes run the whole pipeline.
LLM_PROVIDER=fake                      # workers-ai | fake
PHOTO_PROVIDER=fake                    # cloudflare | fake
PHOTO_FAKE_MODE=ok                     # ok | not_enabled (the fake behaves like a zone without transformations)
# --- the business phone line (migration 0085): Quo (formerly OpenPhone). quo sends texts with QUO_API_KEY; fake records
# them locally. The deploy creates the webhook and its signing secret (QUO_WEBHOOK_SECRET); locally the fake's fixed secret.
QUO_PROVIDER=fake                      # quo | fake
CRM_PROVIDER=fake                      # gohighlevel | fake (unset: gohighlevel in production); partner tokens live in the vault, never here
QUO_API_KEY=                           # server only (Worker secret); the CarmaCars Quo workspace's key, never another account's
QUO_API_BASE=                          # empty: https://api.openphone.com
QUO_WEBHOOK_SECRET=                    # whsec_... of /api/webhooks/quo
# --- sign-in by phone (migration 0091): Supabase Auth's Send SMS hook calls /api/webhooks/auth-sms, signed with this
# Standard Webhooks secret (v1,whsec_...). The deploy makes it (vault: deploy_auth_sms_hook_secret); locally the fixed one.
AUTH_SMS_HOOK_SECRET=
# --- sign-in with a provider: google, microsoft, apple, facebook (comma list). Empty: no provider buttons. On Supabase
# each must first be switched on in Supabase Auth; locally (DATA_BACKEND=local) a stand-in consent page fakes them.
AUTH_OAUTH_PROVIDERS=google
# --- the Google reviews sync (migration 0138): the OAuth Web client of the Google Cloud project with the Business Profile
# APIs (redirect URI <site>/api/google/reviews/callback). Empty: Admin > Settings > Reviews says the keys are not set.
GOOGLE_REVIEWS_CLIENT_ID=
GOOGLE_REVIEWS_CLIENT_SECRET=
